---
/**
 * BackgroundVideo — 动态视频背景（organism）。
 *
 * 职责：当 `wallpaperMode === "video"` 时，在页面最底层渲染一段全屏循环静音视频作为背景；
 * 支持 60 / 120 帧率档切换（访客在显示设置中选择），reduced-motion 时暂停视频。
 *
 * 零额外负担：
 * - 非 video 模式时运行时会移除节点，零 DOM、零请求；
 * - `<video>` 不预置 src，仅在实际播放时由运行时赋值，避免非视频模式下发起请求；
 * - 帧率档切换只替换 src，不重新创建节点。
 */
import { url } from "@utils/url-utils";
import { siteConfig } from "@/config";

const video = siteConfig.backgroundVideo;
const sources = (video?.src ?? {}) as Record<string, string>;
const defaultFps = video?.defaultFps ?? "60";
const position = video?.position ?? "center";
const dimOpacity = video?.dim?.enable
	? Math.min(Math.max(video.dim.opacity, 0), 1)
	: 0;

// 站内路径补 base；外链 / data URL 原样使用。
const resolveSrc = (src: string): string =>
	/^(https?:)?\/\//.test(src) || src.startsWith("data:") ? src : url(src);

const sourceMap = Object.fromEntries(
	Object.entries(sources).map(([fps, src]) => [fps, resolveSrc(src)]),
);
const serializedSources = JSON.stringify(sourceMap);
---

<div
	id="background-video"
	class="background-video"
	data-sources={serializedSources}
	data-default-fps={defaultFps}
	data-position={position}
	style={`--bg-video-dim-opacity: ${dimOpacity};`}
	aria-hidden="true"
>
	<video
		class="background-video__video"
		muted
		playsinline
		autoplay
		loop
		preload="auto"
		disablepictureinpicture
		disableRemotePlayback
		style={`object-position: ${position};`}
	></video>
	{dimOpacity > 0 && <div class="background-video__scrim"></div>}
</div>

<script>
	import {
		BACKGROUND_VIDEO_FPS_CHANGE_EVENT,
		getStoredVideoFps,
	} from "@utils/background-video";

	const root = document.getElementById("background-video");
	if (root) {
		const video = root.querySelector<HTMLVideoElement>("video");
		const sources = JSON.parse(
			root.dataset.sources ?? "{}",
		) as Record<string, string>;
		const defaultFps = root.dataset.defaultFps ?? "60";

		// 非 video 模式：零 DOM（移除节点）
		const isVideoMode = () =>
			document.documentElement.dataset.wallpaperMode === "video";

		const playFps = (fps: string) => {
			const src = sources[fps] ?? sources[defaultFps];
			if (!src) return;
			if (video && video.getAttribute("src") !== src) {
				video.src = src;
			}
		};

		const sync = () => {
			if (!isVideoMode()) {
				root.remove();
				return;
			}
			root.classList.add("is-active");
			playFps(getStoredVideoFps(defaultFps));
			if (video) {
				const reduced =
					document.documentElement.classList.contains("motion-reduced") ||
					window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (reduced) {
					video.pause();
				} else if (video.paused) {
					video.play().catch(() => {
						// 自动播放被浏览器拦截时静默降级为静态。
					});
				}
			}
		};

		// 监听 wallpaperMode 切换（无 video 模式则移除）
		window.addEventListener("wallpaper-mode:change", sync);

		// 监听帧率档切换
		window.addEventListener(
			BACKGROUND_VIDEO_FPS_CHANGE_EVENT,
			(e: Event) => {
				const fps = (e as CustomEvent<{ fps: string }>).detail?.fps;
				if (fps) playFps(fps);
			},
		);

		sync();
	}
</script>

<style lang="stylus">
	/* 全屏固定背景层：置于内容最底（-z-20 与纹理画布同级，但 z 更低一层） */
	.background-video
		position: fixed
		inset: 0
		z-index: -21
		overflow: hidden
		pointer-events: none
		opacity: 0
		visibility: hidden
		transition: opacity var(--m3e-duration-long) var(--m3e-easing-standard)

		&.is-active
			opacity: 1
			visibility: visible

	.background-video__video
		width: 100%
		height: 100%
		object-fit: cover

	.background-video__scrim
		position: absolute
		inset: 0
		background: unquote("rgb(0 0 0 / var(--bg-video-dim-opacity))")
</style>
