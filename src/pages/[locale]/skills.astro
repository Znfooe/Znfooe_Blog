---
/** 技能页（多语言变体）：与根目录 skills.astro 同构。 */
import SkillSection from "@components/organisms/SkillSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { localeStaticPaths, renderWithLanguage } from "@utils/i18n-routing";
import { skillsConfig } from "@/config/skillsConfig";
import { resolveSkillsData } from "@/utils/feature-data";

export const getStaticPaths = () => localeStaticPaths();

const { lang } = Astro.props;

renderWithLanguage(lang);

if (!skillsConfig.enable) {
	return Astro.redirect("/404/");
}

const items = resolveSkillsData(skillsConfig);
---

<MainGridLayout
	title={i18n(I18nKey.skills)}
	description={i18n(I18nKey.skillsBanner)}
	page="skills"
	lang={lang}
>
	<SkillSection
		categories={skillsConfig.categories}
		items={items}
		client:visible
	/>
</MainGridLayout>
