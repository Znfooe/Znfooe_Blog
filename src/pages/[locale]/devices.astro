---
/** 设备页（多语言变体）：与根目录 devices.astro 同构。 */
import DeviceSection from "@components/organisms/DeviceSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { localeStaticPaths, renderWithLanguage } from "@utils/i18n-routing";
import { devicesConfig } from "@/config/devicesConfig";
import { resolveDevicesData } from "@/utils/feature-data";

export const getStaticPaths = () => localeStaticPaths();

const { lang } = Astro.props;

renderWithLanguage(lang);

if (!devicesConfig.enable) {
	return Astro.redirect("/404/");
}

const items = resolveDevicesData(devicesConfig);
---

<MainGridLayout
	title={i18n(I18nKey.devices)}
	description={i18n(I18nKey.devicesBanner)}
	page="devices"
	lang={lang}
>
	<DeviceSection
		categories={devicesConfig.categories}
		items={items}
		client:visible
	/>
</MainGridLayout>
