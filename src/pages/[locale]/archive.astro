---
import ArchivePanel from "@components/organisms/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { localeStaticPaths, renderWithLanguage } from "@utils/i18n-routing";
import { getSortedPostsList } from "@utils/content-utils";

export const getStaticPaths = () => localeStaticPaths();

const { lang } = Astro.props;

renderWithLanguage(lang);

const sortedPostsList = await getSortedPostsList();
const archiveSummary = `${sortedPostsList.length} ${i18n(I18nKey.postsCount)}`;
---

<MainGridLayout title={i18n(I18nKey.archive)} description={archiveSummary} page="archive" lang={lang}>
    <ArchivePanel sortedPosts={sortedPostsList} client:visible></ArchivePanel>
</MainGridLayout>
