---
import CompassSection from "@components/organisms/CompassSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { localeStaticPaths, renderWithLanguage } from "@utils/i18n-routing";
import { compassData } from "../../data/compass";

export const getStaticPaths = () => localeStaticPaths();

const { lang } = Astro.props;

renderWithLanguage(lang);
---

<MainGridLayout title={i18n(I18nKey.compass)} description={i18n(I18nKey.compassBanner)} page="compass" lang={lang}>
    <CompassSection shelves={compassData} client:visible></CompassSection>
</MainGridLayout>
