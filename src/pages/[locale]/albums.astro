---
import AlbumSection from "@components/organisms/AlbumSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { localeStaticPaths, renderWithLanguage } from "@utils/i18n-routing";
import { scanVisibleAlbums, toAlbumIndexItem } from "@utils/album-scanner";

export const getStaticPaths = () => localeStaticPaths();

const { lang } = Astro.props;

renderWithLanguage(lang);

const albums = scanVisibleAlbums().map(toAlbumIndexItem);
---

<MainGridLayout title={i18n(I18nKey.albums)} description={i18n(I18nKey.albumsBanner)} page="albums" lang={lang}>
	<AlbumSection {albums} client:visible />
</MainGridLayout>
