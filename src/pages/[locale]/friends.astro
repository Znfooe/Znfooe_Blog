---
import FriendSection from "@components/organisms/FriendSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { localeStaticPaths, renderWithLanguage } from "@utils/i18n-routing";
import { getFriendsList } from "../../data/friends";

export const getStaticPaths = () => localeStaticPaths();

const { lang } = Astro.props;

renderWithLanguage(lang);
---

<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friendsBanner)} page="friends" lang={lang}>
    <FriendSection friends={getFriendsList()} client:visible></FriendSection>
</MainGridLayout>
